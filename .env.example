# =========================================================================
# Azure OpenAI
# =========================================================================
AZURE_OPENAI_ENDPOINT="https://your-resource.services.ai.azure.com"
AZURE_OPENAI_API_KEY="your-api-key"
AZURE_OPENAI_DEPLOYMENT_NAME="gpt-4.1-mini"
AZURE_OPENAI_API_VERSION="2024-12-01-preview"

# =========================================================================
# Azure OpenAI - Embeddings
# =========================================================================
AZURE_OPENAI_EMBEDDING_ENDPOINT="https://your-resource.services.ai.azure.com"
AZURE_OPENAI_EMBEDDING_API_KEY="your-embedding-api-key"
AZURE_OPENAI_EMBEDDING_DEPLOYMENT_NAME="text-embedding-3-small"

# =========================================================================
# Tavily Web Search
# =========================================================================
TAVILY_API_KEY="your-tavily-key"

# =========================================================================
# LangSmith (optional)
# =========================================================================
LANGCHAIN_TRACING_V2="false"
LANGCHAIN_API_KEY=""
LANGCHAIN_PROJECT="scoutly-ai"
LANGSMITH_TRACING="false"

# =========================================================================
# Player data
# =========================================================================
# The database is populated ONCE, offline:
#     python -m backend.data_pipeline.cache_builder
# Requests are then served from data/fbref_cache.db and never scrape.
#
# Allow tools to hit FBref live when the cache misses. Leave "false" — a live
# scrape opens Chrome and takes minutes per table.
FBREF_LIVE_SCRAPE="false"
# Skip ScraperFC entirely, even in the builder (containers with no Chrome).
FBREF_USE_MOCK="false"

# =========================================================================
# RAG knowledge base (offline loader only)
# =========================================================================
# Defaults to data/kb/ inside the repo, falling back to ../KB and ../docs/skills.
# KB_PROFILES_PATH="/path/to/profiles_enriched.json"
# KB_SKILLS_DIR="/path/to/skills"

# Optional: LLM-driven chart exploration. Off by default — it needs ~15k tokens
# per call, above Groq's 12k/minute allowance, and produced nothing in testing.
ANALYSIS_LLM_CHARTS="false"
