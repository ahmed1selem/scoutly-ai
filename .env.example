# =========================================================================
# Chat provider — pick one
# =========================================================================
# "groq" (default) or "azure". Everything below is read per provider, so an
# unset key here is why an otherwise healthy deployment fails on its first
# agent with "no API key configured".
LLM_PROVIDER="groq"

# =========================================================================
# Groq — the default provider
# =========================================================================
# Comma-separated. Each key is rotated per request, and keys from different
# Groq organisations carry independent daily budgets, so more keys means more
# runs per day rather than just a higher burst rate.
# Groq deprecates and removes models with little notice — llama-3.3-70b-versatile
# was pulled entirely (a 404 model_not_found, not a slowdown) with no warning in
# this repo's history. Check https://console.groq.com/docs/models before
# assuming this value still resolves, and see demo_preflight.py's model check.
GROQ_API_KEYS="gsk_your-first-key,gsk_your-second-key"
GROQ_MODEL="openai/gpt-oss-120b"
GROQ_BASE_URL="https://api.groq.com/openai/v1"

# =========================================================================
# Azure OpenAI — only needed when LLM_PROVIDER=azure
# =========================================================================
AZURE_OPENAI_ENDPOINT="https://your-resource.services.ai.azure.com"
AZURE_OPENAI_API_KEY="your-api-key"
AZURE_OPENAI_DEPLOYMENT_NAME="gpt-4.1-mini"
AZURE_OPENAI_API_VERSION="2024-12-01-preview"

# =========================================================================
# Azure OpenAI - Embeddings
# =========================================================================
AZURE_OPENAI_EMBEDDING_ENDPOINT="https://your-resource.services.ai.azure.com"
AZURE_OPENAI_EMBEDDING_API_KEY="your-embedding-api-key"
AZURE_OPENAI_EMBEDDING_DEPLOYMENT_NAME="text-embedding-3-small"

# =========================================================================
# Tavily Web Search
# =========================================================================
TAVILY_API_KEY="your-tavily-key"

# =========================================================================
# LangSmith (optional)
# =========================================================================
LANGCHAIN_TRACING_V2="false"
LANGCHAIN_API_KEY=""
LANGCHAIN_PROJECT="scoutly-ai"
LANGSMITH_TRACING="false"

# =========================================================================
# Player data
# =========================================================================
# The database is populated ONCE, offline:
#     python -m backend.data_pipeline.cache_builder
# Requests are then served from data/fbref_cache.db and never scrape.
#
# Allow tools to hit FBref live when the cache misses. Leave "false" — a live
# scrape opens Chrome and takes minutes per table.
FBREF_LIVE_SCRAPE="false"
# Skip ScraperFC entirely, even in the builder (containers with no Chrome).
FBREF_USE_MOCK="false"

# =========================================================================
# RAG knowledge base (offline loader only)
# =========================================================================
# Defaults to data/kb/ inside the repo, falling back to ../KB and ../docs/skills.
# KB_PROFILES_PATH="/path/to/profiles_enriched.json"
# KB_SKILLS_DIR="/path/to/skills"

# Optional: LLM-driven chart exploration. Off by default — it needs ~15k tokens
# per call, above Groq's 12k/minute allowance, and produced nothing in testing.
ANALYSIS_LLM_CHARTS="false"
